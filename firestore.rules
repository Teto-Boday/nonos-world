rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function admin() { return signed() && exists(/databases/$(database)/documents/admins/$(me())); }
    function userDoc(uid) { return get(/databases/$(database)/documents/users/$(uid)).data; }
    function linked(uid) {
      return signed() && exists(/databases/$(database)/documents/users/$(uid))
        && userDoc(uid).get('partner', null) == me()
        && userDoc(me()).get('partner', null) == uid;
    }
    function shares(uid, sec) { return userDoc(uid).get('share', {}).get(sec, true) != false; }
    function banned() { return userDoc(me()).get('banned', false) == true; }

    match /admins/{uid} {
      allow read: if signed() && me() == uid;
    }

    match /users/{uid} {
      allow read: if signed() && (me() == uid || admin() || resource.data.get('partner', null) == me());
      allow create: if signed() && me() == uid && !request.resource.data.keys().hasAny(['banned']);
      allow update: if admin() || (signed() && me() == uid
        && request.resource.data.get('banned', false) == resource.data.get('banned', false));
      allow delete: if admin();
    }

    match /invites/{code} {
      allow read: if signed();
      allow create: if signed() && request.resource.data.uid == me();
      allow delete: if signed() && resource.data.uid == me();
    }

    match /linkRequests/{uid} {
      allow read, delete: if signed() && (me() == uid || resource.data.from == me());
      allow create, update: if signed() && request.resource.data.from == me();
    }

    match /u/{uid}/sec/{sec} {
      allow read: if signed() && (me() == uid || admin()
        || (linked(uid) && (sec in ['prefs', 'msgs'] || shares(uid, sec))));
      allow write: if signed() && ((me() == uid && !banned()) || (sec == 'msgs' && linked(uid)));
    }

    match /u/{uid}/chat/{id} {
      allow read: if signed() && (me() == uid || admin() || (linked(uid) && shares(uid, 'diary')));
      allow create: if signed() && ((me() == uid && !banned()) || (linked(uid) && request.resource.data.from == 'him' && !banned()));
      allow update: if signed() && (me() == uid || (linked(uid) && resource.data.from == 'him'));
      allow delete: if signed() && (me() == uid || admin() || (linked(uid) && resource.data.from == 'him'));
    }

    // private chat between two linked partners: couples/{uidA_uidB}/msgs (uids sorted)
    function couple(cid) {
      let p = userDoc(me()).get('partner', '');
      return signed() && p != '' && p != null && (cid == me() + '_' + p || cid == p + '_' + me()) && linked(p);
    }
    match /couples/{cid}/msgs/{mid} {
      allow read: if couple(cid) || admin();
      allow create: if couple(cid) && !banned() && request.resource.data.from == me()
        && request.resource.data.text is string && request.resource.data.text.size() <= 2000;
      allow delete: if (couple(cid) && resource.data.from == me()) || admin();
    }

    // friends: a lighter link than a partner. They see only what you tap in "what did you do today" (act/{uid}) and chat together
    function friendOk(uid) {
      return (exists(/databases/$(database)/documents/friends/$(uid + '_' + me()))
          && get(/databases/$(database)/documents/friends/$(uid + '_' + me())).data.status == 'ok')
        || (exists(/databases/$(database)/documents/friends/$(me() + '_' + uid))
          && get(/databases/$(database)/documents/friends/$(me() + '_' + uid)).data.status == 'ok');
    }
    function friendDoc(pid) { return get(/databases/$(database)/documents/friends/$(pid)).data; }
    match /friendCodes/{code} {
      allow read: if signed();
      allow create: if signed() && request.resource.data.uid == me() && request.resource.data.keys().hasOnly(['uid', 'name']);
      allow delete: if admin();
    }
    match /friends/{pid} {
      allow read: if signed() && (me() in resource.data.members || admin());
      allow create: if signed() && !banned() && request.resource.data.from == me() && request.resource.data.status == 'pending'
        && request.resource.data.members.size() == 2 && me() in request.resource.data.members
        && pid == request.resource.data.members[0] + '_' + request.resource.data.members[1];
      allow update: if signed() && me() in resource.data.members && resource.data.from != me()
        && resource.data.status == 'pending' && request.resource.data.status == 'ok'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'names', 'topics']);
      allow delete: if signed() && (me() in resource.data.members || admin());
      match /msgs/{mid} {
        allow read: if signed() && ((me() in friendDoc(pid).members && friendDoc(pid).status == 'ok') || admin());
        allow create: if signed() && !banned() && request.resource.data.from == me()
          && me() in friendDoc(pid).members && friendDoc(pid).status == 'ok'
          && request.resource.data.text is string && request.resource.data.text.size() <= 2000;
        allow delete: if signed() && (resource.data.from == me() || admin());
      }
    }
    match /act/{uid} {
      allow read: if signed() && (me() == uid || admin() || friendOk(uid));
      allow write: if signed() && me() == uid && !banned();
      allow delete: if admin();
    }

    // app-wide settings the owner edits from the admin panel
    match /config/{id} {
      allow read: if signed();
      allow write: if admin();
    }

    // a user asks to change their username; the GitHub Action checks it's free and applies it
    match /usernameRequests/{uid} {
      allow read, delete: if signed() && (me() == uid || admin());
      allow create, update: if signed() && (admin() || (me() == uid && !banned()))
        && request.resource.data.keys().hasOnly(['username', 'status', 'at'])
        && request.resource.data.status == 'new'
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[a-z0-9_.]{3,20}$');
    }

    match /resetRequests/{id} {
      allow create: if admin() || request.resource.data.keys().hasOnly(['username', 'contact', 'note', 'status', 'at'])
        && request.resource.data.status == 'new'
        && request.resource.data.username is string && request.resource.data.username.size() <= 20
        && request.resource.data.contact is string && request.resource.data.contact.size() <= 80
        && request.resource.data.note is string && request.resource.data.note.size() <= 140;
      allow read, update, delete: if admin();
    }

    function member(gid) { return me() in get(/databases/$(database)/documents/groups/$(gid)).data.members; }

    match /groups/{gid} {
      allow read: if signed() && (me() in resource.data.members || admin());
      allow create: if signed() && request.resource.data.owner == me() && request.resource.data.members == [me()] && !banned();
      allow update: if signed() && (
        // join or leave yourself (members and your name only)
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names'])
          && (request.resource.data.members.toSet().difference(resource.data.members.toSet()) == [me()].toSet()
              || resource.data.members.toSet().difference(request.resource.data.members.toSet()) == [me()].toSet()))
        // members update the last-message preview
        || (me() in resource.data.members && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['last', 'lastText']))
        // members save their own notification address
        || (me() in resource.data.members && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['topics'])
          && request.resource.data.topics.diff(resource.data.get('topics', {})).affectedKeys().hasOnly([me()])));
      allow delete: if signed() && (resource.data.owner == me() || admin());

      match /msgs/{mid} {
        allow read: if signed() && (member(gid) || admin());
        allow create: if signed() && request.resource.data.from == me() && member(gid) && !banned();
        allow delete: if signed() && (resource.data.from == me() || admin());
      }
    }

    match /groupCodes/{code} {
      allow read: if signed();
      allow create: if signed() && request.resource.data.keys().hasOnly(['gid', 'name']);
      allow delete: if admin();
    }

    // the owner asks for an account to be deleted; a GitHub Action removes it for good
    match /deleteRequests/{uid} {
      allow read, write: if admin();
    }

    match /feedback/{id} {
      allow create: if signed() && request.resource.data.uid == me() && request.resource.data.text is string && request.resource.data.text.size() <= 300;
      allow read, delete: if admin();
    }

    match /publicReviews/{uid} {
      allow read: if true;
      allow create, update: if signed() && me() == uid && !banned()
        && request.resource.data.keys().hasOnly(['name', 'stars', 'text', 'g', 'at'])
        && request.resource.data.stars is int && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
        && request.resource.data.text is string && request.resource.data.text.size() <= 300;
      allow delete: if signed() && (me() == uid || admin());
    }

    match /reports/{id} {
      allow create: if signed();
      allow read, update, delete: if admin();
    }
  }
}
